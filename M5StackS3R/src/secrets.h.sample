#pragma once

// ============================================================
// 環境ごとに切り替えるのはここだけ（Wi-Fi と Mac の IP）
//   IP は `ipconfig getifaddr en0` で確認
// ============================================================
#define WIFI_SSID     "YOUR_SSID"
#define WIFI_PASSWORD "YOUR_PASSWORD"
#define MAC_IP        "192.168.x.x"   // Mac の LAN IP

// ---- 上の MAC_IP からローカルサーバーの URL を組み立て ----
#define WHISPER_URL   "http://" MAC_IP ":8080/inference"
#define AIVIS_BASE    "http://" MAC_IP ":10101"   // AivisSpeech Engine（VOICEVOX互換API）。VOICEVOXは:50021
#define OLLAMA_URL    "http://" MAC_IP ":11434/api/chat"

// ============================================================
// LLMプロバイダ選択
//   LLM_OLLAMA / LLM_OPENAI / LLM_GEMINI / LLM_AZURE のいずれかを指定
//   （識別子の数値定義は main.cpp 冒頭にあります）
// ============================================================
#define LLM_PROVIDER  LLM_OLLAMA

// --- Ollama (ローカル / 平文HTTP。URL は上の MAC_IP から組み立て) ---
#define OLLAMA_MODEL  "gemma3:12b"

// --- OpenAI (https://platform.openai.com/api-keys) ---
#define OPENAI_API_KEY "sk-..."
#define OPENAI_MODEL   "gpt-4o-mini"

// --- Azure OpenAI ---
#define AZURE_API_KEY     "..."
#define AZURE_ENDPOINT    "https://YOUR-RESOURCE.openai.azure.com"
#define AZURE_DEPLOYMENT  "gpt-4o-mini"
#define AZURE_API_VERSION "2024-10-21"

// --- Gemini (https://aistudio.google.com/apikey) ---
